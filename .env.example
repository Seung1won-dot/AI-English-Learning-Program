# ===========================================================
#  AI 키 설정 — 아래 중 "하나만" 채우면 됩니다.
#  아무것도 안 채워도 규칙기반(목업) 피드백으로 정상 동작합니다.
#  우선순위: GROQ_API_KEY > OPENAI_API_KEY > 목업
# ===========================================================

# ▶ 무료 AI (추천) — Groq
#   https://console.groq.com 에서 무료 가입 후 API Key 발급
GROQ_API_KEY=
# 사용할 모델 (선택) — 기본값: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ▶ 유료 AI — OpenAI (쓰고 싶을 때만)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===========================================================
#  배포 설정 (인터넷에 올릴 때)
# ===========================================================
# ▶ 접근 비밀번호 — 설정하면 브라우저가 로그인 창을 띄운다 (아이디는 아무거나).
#   공개 서버라면 꼭 채우세요. 비워 두면 누구나 접속할 수 있습니다.
APP_PASSWORD=
# ▶ 학습 기록 DB 위치 — 배포 플랫폼의 영구 디스크 경로로 지정 (기본: 프로젝트 폴더/learning.db)
# DB_PATH=/data/learning.db

# ▶ Flask 비밀 키 — 세션 서명용. 배포 시 긴 임의 문자열로 채우세요.
#   만들기: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ===========================================================
#  로컬 실행 (python app.py) 옵션 — 보통은 건드리지 않아도 됩니다.
# ===========================================================
# HOST=127.0.0.1          # 0.0.0.0 이면 같은 와이파이의 폰에서도 접속 (디버거는 자동으로 꺼짐)
# PORT=5000
# FLASK_DEBUG=0           # 개발 중에만 1 (코드 수정 시 자동 재시작 + 디버거)
# AI_TIMEOUT_SECONDS=25   # AI 응답을 기다리는 최대 시간(초). 넘으면 목업으로 대체
